<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>My Profile | SkillSwap</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/navbar.css">
</head>

<body class="profile-page">

    <%- include('partials/navbar') %>

    <main class="profile-wrapper">

        <% if (success) { %>
            <div class="alert alert-success" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i><%= success %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
            </div>
        <% } %>

        <section class="profile-card">

            <div class="profile-cover"></div>

            <div class="profile-content">

                <div class="profile-top">

                    <div class="profile-identity">

                        <div class="profile-avatar">
                            <% if (profilePicture) { %>
                                <img
                                    src="/images/<%= profilePicture %>"
                                    alt="<%= profileUser.name %>'s profile picture"
                                >
                            <% } else { %>
                                <%= String(profileUser.name || 'U').charAt(0).toUpperCase() %>
                            <% } %>
                        </div>

                        <div class="profile-name">

                            <h1>
                                <%= profileUser.name %>
                            </h1>

                            <p>
                                <%= profileUser.email %>
                            </p>

                        </div>

                    </div>

                    <div class="profile-actions">

                        <a
                            href="/users/<%= profileUser.id %>?preview=1"
                            class="btn btn-outline-primary"
                            title="See your profile the way other members see it"
                        >
                            <i class="fa-solid fa-eye me-1"></i>
                            Public View
                        </a>

                        <a
                            href="/profile/edit"
                            class="btn btn-primary"
                        >
                            <i class="fa-solid fa-pen me-1"></i>
                            Edit Profile
                        </a>

                        <form
                            action="/logout"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="btn btn-outline-danger"
                            >
                                Log Out
                            </button>

                        </form>

                    </div>

                </div>

                <section class="profile-section">

                    <h2>
                        About Me
                    </h2>

                    <p>
                        <%= profileUser.bio || 'No bio added yet.' %>
                    </p>

                </section>

                <section class="profile-section">

                    <h2>
                        Profile Information
                    </h2>

                    <div class="information-grid">

                        <div class="information-item">

                            <span>
                                Contact Number
                            </span>

                            <strong>
                                <%= profileUser.contact || 'Not provided' %>
                            </strong>

                        </div>

                        <div class="information-item">

                            <span>
                                Role
                            </span>

                            <strong>
                                <%= profileUser.role || 'user' %>
                            </strong>

                        </div>

                        <div class="information-item">

                            <span>
                                Level
                            </span>

                            <strong>
                                Level <%= profileUser.level || 1 %>
                            </strong>

                        </div>

                        <div class="information-item">

                            <span>
                                Experience Points
                            </span>

                            <strong>
                                <%= profileUser.points || 0 %> XP
                            </strong>

                        </div>

                                                <div class="information-item">

                            <span>
                                Member Since
                            </span>

                            <strong>
                                <%= profileUser.created_at
                                    ? new Date(profileUser.created_at).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' })
                                    : '-' %>
                            </strong>

                        </div>

                        <div class="information-item">

                            <span>
                                Last Login
                            </span>

                            <strong>
                                <%= previousLogin
                                    ? new Date(previousLogin).toLocaleString('en-SG', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' })
                                    : 'This is your first login!' %>
                            </strong>

                        </div>

                    </div>

                </section>

                <section class="profile-section">

                    <div class="skill-section-heading">

                        <div>

                            <p class="section-label">
                                Teaching
                            </p>

                            <h2>
                                Skills I Offer
                            </h2>

                        </div>

                        <a
                            href="/skills/add"
                            class="btn btn-sm btn-primary"
                        >
                            <i class="fa-solid fa-plus me-1"></i>
                            Add Skill
                        </a>

                    </div>

                    <% if (!offerSkills || offerSkills.length === 0) { %>

                        <div class="empty-skills">

                            <i class="fa-solid fa-lightbulb"></i>

                            <h3>
                                No offered skills yet
                            </h3>

                            <p>
                                Add a skill that you can teach to another member.
                            </p>

                            <a
                                href="/skills/add"
                                class="btn btn-primary btn-sm"
                            >
                                Add Your First Skill
                            </a>

                        </div>

                    <% } else { %>

                        <div class="skills-grid">

                            <% offerSkills.forEach((skill) => { %>

                                <article class="skill-profile-card">

                                    <div class="skill-card-header">

                                        <div>

                                            <span class="skill-type-label offer-label">
                                                Offer
                                            </span>

                                            <h3>
                                                <%= skill.skill_name %>
                                            </h3>

                                        </div>

                                        <i class="fa-solid fa-chalkboard-user skill-card-icon"></i>

                                    </div>

                                    <p>
                                        <%= skill.description || 'No description added.' %>
                                    </p>

                                    <div class="skill-tags">

                                        <% if (skill.category) { %>
                                            <span class="skill-tag">
                                                <%= skill.category %>
                                            </span>
                                        <% } %>

                                        <% if (skill.skill_level) { %>
                                            <span class="skill-tag">
                                                <%= skill.skill_level %>
                                            </span>
                                        <% } %>

                                        <% if (skill.availability) { %>
                                            <span class="skill-tag">
                                                <%= skill.availability %>
                                            </span>
                                        <% } %>

                                        <% if (skill.location) { %>
                                            <span class="skill-tag">
                                                <i class="fa-solid fa-location-dot me-1"></i>
                                                <%= skill.location %>
                                            </span>
                                        <% } %>

                                    </div>

                                    <div class="skill-card-actions">

                                        <a
                                            href="/skills/<%= skill.id %>/edit"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            <i class="fa-solid fa-pen me-1"></i>
                                            Edit
                                        </a>

                                        <form
                                            action="/skills/<%= skill.id %>/delete"
                                            method="POST"
                                            onsubmit="return confirm('Delete this skill?');"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                            >
                                                <i class="fa-solid fa-trash me-1"></i>
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </article>

                            <% }) %>

                        </div>

                    <% } %>

                </section>

                <section class="profile-section">

                    <div class="skill-section-heading">

                        <div>

                            <p class="section-label">
                                Learning
                            </p>

                            <h2>
                                Skills I Want to Learn
                            </h2>

                        </div>

                        <a
                            href="/skills/add"
                            class="btn btn-sm btn-outline-primary"
                        >
                            <i class="fa-solid fa-plus me-1"></i>
                            Add Learning Skill
                        </a>

                    </div>

                    <% if (!learnSkills || learnSkills.length === 0) { %>

                        <div class="empty-skills">

                            <i class="fa-solid fa-book-open"></i>

                            <h3>
                                No learning skills yet
                            </h3>

                            <p>
                                Add a skill that you would like another member to teach you.
                            </p>

                            <a
                                href="/skills/add"
                                class="btn btn-primary btn-sm"
                            >
                                Add a Learning Skill
                            </a>

                        </div>

                    <% } else { %>

                        <div class="skills-grid">

                            <% learnSkills.forEach((skill) => { %>

                                <article class="skill-profile-card">

                                    <div class="skill-card-header">

                                        <div>

                                            <span class="skill-type-label learn-label">
                                                Learn
                                            </span>

                                            <h3>
                                                <%= skill.skill_name %>
                                            </h3>

                                        </div>

                                        <i class="fa-solid fa-book-open skill-card-icon"></i>

                                    </div>

                                    <p>
                                        <%= skill.description || 'No description added.' %>
                                    </p>

                                    <div class="skill-tags">

                                        <% if (skill.category) { %>
                                            <span class="skill-tag">
                                                <%= skill.category %>
                                            </span>
                                        <% } %>

                                        <% if (skill.skill_level) { %>
                                            <span class="skill-tag">
                                                <%= skill.skill_level %>
                                            </span>
                                        <% } %>

                                        <% if (skill.availability) { %>
                                            <span class="skill-tag">
                                                <%= skill.availability %>
                                            </span>
                                        <% } %>

                                        <% if (skill.location) { %>
                                            <span class="skill-tag">
                                                <i class="fa-solid fa-location-dot me-1"></i>
                                                <%= skill.location %>
                                            </span>
                                        <% } %>

                                    </div>

                                    <div class="skill-card-actions">

                                        <a
                                            href="/skills/<%= skill.id %>/edit"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            <i class="fa-solid fa-pen me-1"></i>
                                            Edit
                                        </a>

                                        <form
                                            action="/skills/<%= skill.id %>/delete"
                                            method="POST"
                                            onsubmit="return confirm('Delete this skill?');"
                                        >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                            >
                                                <i class="fa-solid fa-trash me-1"></i>
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </article>

                            <% }) %>

                        </div>

                    <% } %>

                </section>

            </div>

        </section>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
