<!--
    (Amir Here)
    Requires the route handler to pass `earnedBadges` as an array of badge names.
    Query: SELECT badge_name FROM user_badges WHERE user_id = ?
-->
<% if (earnedBadges && earnedBadges.length > 0) { %>
    <div class="mt-4">
        <h5><i class="bi bi-trophy-fill"></i> Badges Earned</h5>
        <div>
            <% earnedBadges.forEach(function(badge) { %>
                <span class="badge bg-success fs-6 me-1 mb-1"><%= badge %></span>
            <% }); %>
        </div>
        <small class="text-muted"><a href="/badges">View all achievements</a></small>
    </div>
<% } else { %>
    <div class="mt-4">
        <h5>Badges</h5>
        <p class="text-muted">No badges earned yet. <a href="/badges">Track your progress</a></p>
    </div>
<% } %>