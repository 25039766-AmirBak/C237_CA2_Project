<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | SkillSwap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>

<body>
    <main class="auth-wrapper">
        <section class="auth-card">
            <div class="auth-heading">
                <div class="auth-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>

                <h1>Create Your Account</h1>

                <p>Join SkillSwap and start exchanging skills.</p>
            </div>

            <% if (error) { %>
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    <%= error %>
                </div>
            <% } %>

            <form
                action="/register"method="POST">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="name" class="form-label">Full Name *</label>
                        <input type="text"
                            id="name" name="name" class="form-control" maxlength="100" value="<%= formData.name || '' %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="email" class="form-label">Email Address *</label>
                        <input type="email" id="email" name="email" class="form-control" maxlength="255" value="<%= formData.email || '' %>"required >
                    </div>

                    <div class="col-md-6">
                        <label for="password" class="form-label"> Password *</label>
                        <input type="password" id="password" name="password" class="form-control" minlength="6" required >
                        <small class="text-muted"> At least 6 characters.</small>
                    </div>

                    <div class="col-md-6">
                        <label for="confirm_password" class="form-label">Confirm Password *</label>
                        <input type="password" id="confirm_password" name="confirm_password" class="form-control" minlength="6" require>
                    </div>

                    <div class="col-md-6">
                        <label for="contact" class="form-label">Contact Number *</label>
                        <input type="text" id="contact" name="contact" class="form-control" maxlength="30" value="<%= formData.contact || '' %>" required >
                    </div>

                    <div class="col-12">
                        <label for="bio" class="form-label"> Bio </label>
                        <textarea id="bio" name="bio" class="form-control" maxlength="500" placeholder="Tell others a little about yourself..." ><%= formData.bio || '' %></textarea>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary auth-button w-100">
                            <i class="fa-solid fa-user-plus me-2"></i>Create Account
                        </button>
                    </div>
                </div>
            </form>

            <div class="auth-footer">
                Already have an account?
                <a href="/login">Log in here</a>
            </div>
        </section>
    </main>
</body>
</html>