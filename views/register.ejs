<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | SkillSwap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>

<body>
    <main class="auth-wrapper">
        <section class="auth-card">
            <div class="auth-heading">
                <div class="auth-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>

                <h1>Create Your Account</h1>

                <p>Join SkillSwap and start exchanging skills.</p>
            </div>

            <% if (success) { %>
                <div class="alert alert-success" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i><%= success %>
                </div>
            <% } %>

            <% if (error) { %>
                <div class="alert alert-danger" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
                </div>
            <% } %>

            <form action="/register" method="POST" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="name" class="form-label">Full Name *</label>
                        <input type="text"
                            id="name" name="name" class="form-control" maxlength="100" value="<%= formData.name || '' %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="email" class="form-label">Email Address *</label>
                        <input type="email" id="email" name="email" class="form-control" maxlength="255" value="<%= formData.email || '' %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="password" class="form-label"> Password *</label>
                        <div class="input-group">
                            <input type="password" id="password" name="password" class="form-control" minlength="6" required>
                            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="password" aria-label="Show password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>

                        <div class="strength-meter" id="strengthMeter" hidden>
                            <div class="strength-track">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <small id="strengthText" class="text-muted"></small>
                        </div>

                        <ul class="strength-checklist" id="strengthChecklist" hidden>
                            <li data-check="length"><i class="fa-solid fa-circle-xmark"></i> At least 6 characters</li>
                            <li data-check="upper"><i class="fa-solid fa-circle-xmark"></i> An uppercase letter</li>
                            <li data-check="number"><i class="fa-solid fa-circle-xmark"></i> A number</li>
                            <li data-check="symbol"><i class="fa-solid fa-circle-xmark"></i> A symbol (!@#$...)</li>
                        </ul>
                    </div>

                    <div class="col-md-6">
                        <label for="confirm_password" class="form-label">Confirm Password *</label>
                        <div class="input-group">
                            <input type="password" id="confirm_password" name="confirm_password" class="form-control" minlength="6" required>
                            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="confirm_password" aria-label="Show password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <small id="matchText" hidden></small>
                    </div>

                    <div class="col-md-6">
                        <label for="contact" class="form-label">Contact Number *</label>
                        <input type="text" id="contact" name="contact" class="form-control" maxlength="30" value="<%= formData.contact || '' %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="profile_picture" class="form-label">Profile Picture</label>
                        <input type="file" id="profile_picture" name="profile_picture" class="form-control" accept="image/*">
                        <small class="text-muted"> Optional, max 2MB.</small>
                    </div>

                    <div class="col-12">
                        <label for="bio" class="form-label"> Bio </label>
                        <textarea id="bio" name="bio" class="form-control" maxlength="500" placeholder="Tell others a little about yourself..."><%= formData.bio || '' %></textarea>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary auth-button w-100">
                            <i class="fa-solid fa-user-plus me-2"></i>Create Account
                        </button>
                    </div>
                </div>
            </form>

            <div class="auth-footer">
                Already have an account?
                <a href="/login">Log in here</a>
            </div>
        </section>
    </main>

    <script>
        // ------------------------------------------------------------
        // Member 1: live password strength meter + show/hide toggles
        // ------------------------------------------------------------
        const passwordInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirm_password');
        const meter = document.getElementById('strengthMeter');
        const fill = document.getElementById('strengthFill');
        const strengthText = document.getElementById('strengthText');
        const checklist = document.getElementById('strengthChecklist');
        const matchText = document.getElementById('matchText');

        const levels = [
            { min: 0, label: 'Very weak', color: '#dc3545', width: '15%' },
            { min: 2, label: 'Weak',      color: '#fd7e14', width: '40%' },
            { min: 3, label: 'Good',      color: '#ffc107', width: '70%' },
            { min: 4, label: 'Strong',    color: '#198754', width: '100%' }
        ];

        const runChecks = (value) => ({
            length: value.length >= 6,
            upper: /[A-Z]/.test(value),
            number: /[0-9]/.test(value),
            symbol: /[^A-Za-z0-9]/.test(value)
        });

        const updateStrength = () => {
            const value = passwordInput.value;
            meter.hidden = value.length === 0;
            checklist.hidden = value.length === 0;
            if (!value) return;

            const checks = runChecks(value);
            const score = Object.values(checks).filter(Boolean).length;

            checklist.querySelectorAll('li').forEach((item) => {
                const passed = checks[item.dataset.check];
                item.classList.toggle('check-passed', passed);
                item.querySelector('i').className = passed
                    ? 'fa-solid fa-circle-check'
                    : 'fa-solid fa-circle-xmark';
            });

            const level = levels.filter((l) => score >= l.min).pop();
            fill.style.width = level.width;
            fill.style.background = level.color;
            strengthText.textContent = 'Password strength: ' + level.label;
        };

        const updateMatch = () => {
            const value = confirmInput.value;
            matchText.hidden = value.length === 0;
            if (!value) return;

            const matches = value === passwordInput.value;
            matchText.textContent = matches
                ? 'Passwords match'
                : 'Passwords do not match';
            matchText.className = matches ? 'text-success' : 'text-danger';
        };

        passwordInput.addEventListener('input', () => {
            updateStrength();
            updateMatch();
        });
        confirmInput.addEventListener('input', updateMatch);

        document.querySelectorAll('.toggle-password').forEach((button) => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.dataset.target);
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                button.querySelector('i').className = show
                    ? 'fa-solid fa-eye-slash'
                    : 'fa-solid fa-eye';
            });
        });
    </script>
</body>
</html>
