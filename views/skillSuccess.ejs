<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skill Added Successfully</title>
    <link rel="stylesheet" href="/css/skill.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <main class="success-page">
        <section class="success-card">

            <div class="background-glow background-glow-one"></div>
            <div class="background-glow background-glow-two"></div>

            <span class="star star-one">✦</span>
            <span class="star star-two">✦</span>
            <span class="star star-three">✦</span>
            <span class="star star-four">•</span>
            <span class="star star-five">•</span>

            <div class="illustration-container">

                <div class="orbit orbit-one"></div>
                <div class="orbit orbit-two"></div>
                <div class="rocket-wrapper">
                    <i class="fa-solid fa-rocket rocket-icon"></i>
                </div>
                <div class="success-tick">
                    <i class="fa-solid fa-check"></i>
                </div>
            </div>

            <div class="success-content">
                <h1>Skill Added Successfully! 🎉</h1>
                <p>Your skill has been published and is now visible to others.
                    <br>
                    Start connecting and sharing your knowledge!
                </p>
            </div>

            <!-- Buttons -->
            <div class="button-group">
                <a href="/my-skills" class="success-button primary-button"> View My Skills</a>
                <a href="/skills" class="success-button secondary-button">Browse More Skills</a>

            </div>
        </section>
    </main>

</body>
</html>