<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/skill.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>SkillSwap</title>
</head>
<body class="add-skill-page">
    <%- include('partials/navbar') %>
            
    <div class="add-skill-container">

        <h1 class="page-title">Add a New Skill</h1>
        <p class="page-subtitle">
            Share your knowledge and help others learn something new.
        </p>
        
        <% if (typeof error !== "undefined" && error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>

        <form action="/skills/add" method="POST" class="skill-form">

            <!-- Skill Name -->
            <div class="form-group">
                <label>Skill Name</label>

                <input type="text" name="skill_name" placeholder="Example: Python Programming" 
                value="<%= typeof formData !== 'undefined' && formData.skill_name ? formData.skill_name : '' %>"
                required>
            </div>

            <!-- Category -->
            <div class="form-group">
                <label>Category</label>

                <select id= "category" name="category" required>

                    <option value="">Choose a Category</option>

                    <option value="Technology">Technology</option>
                    <option value="Language">Language</option>
                    <option value="Music">Music</option>
                    <option value="Design">Design</option>
                    <option value="Business">Business</option>
                    <option value="Lifestyle">Lifestyle</option>
                    <option value="Sports">Sports</option>
                    <option value="Other">Other</option>

                </select>
            </div>

            <!-- Skill Level -->
            <div class="form-group">
                <label>Skill Level</label>

                <select id="skill_level" name="skill_level" required>

                    <option value="">Select Level</option>
                    <option value="Beginner">Beginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                    <option value="Expert">Expert</option>
                </select>
            </div>

            <div class="form-group">
                <label>Skill Type</label>

                <select id="skill_type" name="skill_type" required>
                    <option value="">Select Skill Type</option>

                    <option
                        value="Offer"
                        <%= typeof formData !== "undefined" &&
                            formData.skill_type === "Offer"
                            ? "selected"
                            : "" %>>
                        Offering This Skill
                    </option>

                    <option
                        value="Learn"
                        <%= typeof formData !== "undefined" &&
                            formData.skill_type === "Learn"
                            ? "selected"
                            : "" %>>
                        Looking to Learn This Skill
                    </option>
                </select>
            </div>

            <!-- Description -->
            <div class="form-group">
                <label>Description</label>

                <textarea id="description" name="description" rows="6" placeholder="Tell others what you will learn/teach..." 
                required
                ><%= typeof formData !== "undefined" && formData.description ? formData.description : "" %></textarea>
            </div>


            <!-- Availability -->
            <div class="form-group">
                <label>Availability</label>

                <select id="availability" name="availability" required>

                    <option value="">Select Availability</option>
                    <option value="Weekdays">Weekdays</option>
                    <option value="Weekends">Weekends</option>
                    <option value="Evenings">Evenings</option>
                    <option value="Flexible">Flexible</option>
                </select>
            </div>


            <!-- Location -->
            <div class="form-group">
                <label>Location</label>

                <input type="text" id="location" name="location" placeholder="Example: Online / Tampines" 
                value="<%= typeof formData !== 'undefined' && formData.location ? formData.location : '' %>"
                required>
            </div>

            <!-- Buttons -->
            <div class="button-group">

                <a href="/skills" class="cancel-btn">Cancel</a>

                <button type="submit" class="submit-btn">Publish Skill</button>
            </div>
        </form>
    </div>

</body>
</html>