<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/navbar.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>SkillSwap</title>
</head>
<body>
    <div class="text-center d-flex align-items-center justify-content-center"
        style="background-image: url('/images/bg-home.png');background-size: relative;background-position: center;
        background-repeat: no-repeat; min-height: 100vh;">

        <div class="row">
            <div class="col-12">
                <h1 class="fw-bold display-1 mb-3" style="color: #5a32a3;">SkillSwap</h1>
                <p class="h5 mb-4 text-secondary">Trade Skills. Build Connections. Level Up.</p>
                <% if (currentUser) { %>
                    <a href="/profile" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                        View My Profile
                    </a>
                <% } else { %>
                    <a href="/register" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                        Get Started
                    </a>
                <% } %>
            </div>
        </div>

    </div>
</body>
</html>

