 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>SkillSwap - Messages</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container-fluid py-4">

        <% errors.forEach(function(e) { %>
            <div class="alert alert-danger"><%= e %></div>
        <% }) %>
        <% successMsgs.forEach(function(s) { %>
            <div class="alert alert-success"><%= s %></div>
        <% }) %>

        <div class="row">

            <!-- Chat Sidebar -->
            <div class="col-md-4 border-end">
                <h5 class="mb-3">Conversations</h5>
                <ul class="list-group mb-4">
                    <% conversations.forEach(function(c) { %>
                        <a href="/messages?with=<%= c.id %>"
                           class="list-group-item list-group-item-action <%= (partner && partner.id === c.id) ? 'active' : '' %>">
                            <%= c.username %>
                        </a>
                    <% }) %>
                    <% if (conversations.length === 0) { %>
                        <li class="list-group-item text-muted">No conversations yet</li>
                    <% } %>
                </ul>

                <h6 class="mb-2">Start a new conversation</h6>
                <form method="GET" action="/messages">
                    <select name="with" class="form-select" onchange="this.form.submit()">
                        <option value="">Select a user...</option>
                        <% allUsers.forEach(function(u) { %>
                            <option value="<%= u.id %>" <%= (partner && partner.id === u.id) ? 'selected' : '' %>>
                                <%= u.username %>
                            </option>
                        <% }) %>
                    </select>
                </form>
            </div>

            <!-- Chat Window -->
            <div class="col-md-8">
                <% if (partner) { %>
                    <h5 class="mb-3">Chat with <%= partner.username %></h5>

                    <div class="border rounded p-3 mb-3" style="height: 400px; overflow-y: auto;">
                        <% thread.forEach(function(m) { %>
                            <div class="mb-2 <%= m.sender_id == partner.id ? 'text-start' : 'text-end' %>">
                                <span class="badge <%= m.sender_id == partner.id ? 'bg-secondary' : 'bg-primary' %>">
                                    <%= m.sender_username %>
                                </span>
                                <div><%= m.message_text %></div>
                                <small class="text-muted"><%= new Date(m.created_at).toLocaleString('en-SG') %></small>
                            </div>
                        <% }) %>
                        <% if (thread.length === 0) { %>
                            <p class="text-muted">No messages yet. Say hello!</p>
                        <% } %>
                    </div>

                    <form method="POST" action="/chat/send" class="d-flex gap-2">
                        <input type="hidden" name="receiver_id" value="<%= partner.id %>">
                        <input type="text" name="message_text" class="form-control" placeholder="Type a message..." required>
                        <button type="submit" class="btn btn-primary">Send</button>
                    </form>
                <% } else { %>
                    <p class="text-muted">Select a conversation on the left to start chatting.</p>
                <% } %>
            </div>

        </div>
    </div>
</body>
</html>