<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/schedule.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>SkillSwap - Schedule</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container py-4">

        <% errors.forEach(function(e) { %>
            <div class="alert alert-danger"><%= e %></div>
        <% }) %>
        <% successMsgs.forEach(function(s) { %>
            <div class="alert alert-success"><%= s %></div>
        <% }) %>

        <h3 class="mb-4">My Sessions</h3>

        <!-- Session Cards -->
        <div class="row mb-5">
            <% if (sessions.length === 0) { %>
                <p class="text-muted">No upcoming sessions booked.</p>
            <% } %>
            <% sessions.forEach(function(session) { %>
    <div class="col-md-4 mb-3">
        <article class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title"> <%= session.skill_name %></h5>
                <p class="card-text mb-1">
                    <% if (
                        Number(session.learner_id) === Number(user.id)
                    ) { %>
                        Teacher:
                        <strong><%= session.teacher_name %> </strong>
                    <% } else { %>
                        Learner:
                        <strong> <%= session.learner_name %></strong>
                    <% } %>
                </p>

                <p class="card-text mb-1">
                    Date:
                    <strong>
                        <%= session.session_date instanceof Date
                            ? session.session_date
                                .toISOString()
                                .slice(0, 10)
                            : session.session_date %>
                    </strong>
                </p>

                <p class="card-text mb-1"> Time:
                    <strong><%= session.session_time %> </strong>
                </p>

                <p class="card-text">Status:  
                    <span class="badge <%=
                        session.status === 'Confirmed' ? 'bg-success' :
                        session.status === 'Pending' ? 'bg-warning text-dark' :
                        session.status === 'Completed' ? 'bg-primary' :
                        session.status === 'Cancelled' ? 'bg-secondary' :
                        session.status === 'Rejected' ? 'bg-danger' : 'bg-secondary'
                    %>"><%= session.status %></span>
                </p>

                <% if (
                    session.status === 'Pending' &&
                    Number(session.teacher_id) === Number(user.id)
                ) { %>
                    <div class="d-flex gap-2 mb-2">
                        <form method="POST" action="/schedule/<%= session.session_id %>/accept">
                            <button type="submit" class="btn btn-success btn-sm">Confirm</button>
                        </form>
                        <form method="POST" action="/schedule/<%= session.session_id %>/reject">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Decline</button>
                        </form>
                    </div>
                <% } %>

                <% if (
                    session.status === 'Confirmed' &&
                    Number(session.teacher_id) === Number(user.id)
                ) { %>
                    <form method="POST" action="/schedule/<%= session.session_id %>/complete" onsubmit="return confirm('Mark this session as completed?');">
                        <button type="submit" class="btn btn-success btn-sm">Complete</button>
                    </form>
                <% } %>
                <% if (
                    !['cancelled', 'completed', 'rejected'].includes(String(session.status).toLowerCase())
                ) { %>
                    <form method="POST" action="/schedule/cancel/<%= session.session_id %>" onsubmit="return confirm('Cancel this session?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm" > Cancel </button>
                    </form>
                <% } %>
            </div>
        </article>
    </div>
<% }) %>

        <!-- Booking Form -->
        <% if (availableSkills.length === 0) { %>
            <div class="alert alert-info"> There are currently no offered skills available. </div>

        <% } else { %>
            <form method="POST" action="/schedule" class="row g-3">
                <div class="col-md-5">
                    <label for="skill_id" class="form-label">  Skill and Teacher</label>
                    <select id="skill_id" name="skill_id" class="form-select" required>
                        <option value=""> Choose a skill</option>

                        <% availableSkills.forEach(function(skill) { %>
                            <option value="<%= skill.id %>">
                                <%= skill.skill_name %>
                                — <%= skill.teacher_name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-md-3">
                    <label for="session_date" class="form-label">Date</label>
                    <input type="date" id="session_date" name="session_date" class="form-control" required></div>

                <div class="col-md-2">
                    <label for="session_time" class="form-label">Time </label>
                    <input type="time" id="session_time" name="session_time" class="form-control" required>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit"  class="btn btn-primary w-100"> Book</button>
                </div>
            </form>
        <% } %>
    </div>
</body>
</html>