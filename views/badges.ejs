<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/badges.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Badges - SkillSwap</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="mb-4">Badges</h1>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">Level <%= level %></h5>
                        <p class="card-text"><%= xp %> / <%= xpForNextLevel %> XP</p>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" data-width="<%= progressPercent + '%' %>">
                                <%= Math.round(progressPercent) + '%' %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">Stats</h5>
                        <p class="card-text mb-1">Total Exchanges Completed: <strong><%= totalExchanges %></strong></p>
                        <p class="card-text mb-1">Exchanges as Teacher: <strong><%= teacherExchanges %></strong></p>
                        <p class="card-text">XP per Exchange: <strong>100</strong></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-12">
                <h2>Achievements & Badges</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="card h-100 <%= earnedBadges.includes('First Step') ? 'border-success' : 'opacity-50' %>">
                    <div class="card-body text-center">
                        <img src="/images/first_step.jpg" alt="First Step" style="height: 64px;">
                        <h5 class="card-title mt-2">First Step</h5>
                        <p class="card-text">Complete your first skill exchange</p>
                        <% if (earnedBadges.includes('First Step')) { %>
                            <span class="badge bg-success fs-6">Earned</span>
                        <% } else { %>
                            <span class="badge bg-secondary fs-6">Locked</span>
                            <div class="mt-2">
                                <small>Progress: <%= Math.min(totalExchanges, 1) %> / 1</small>
                                <div class="progress mt-1" style="height: 8px;">
                                    <div class="progress-bar" data-width="<%= (totalExchanges >= 1 ? 100 : 0) + '%' %>"></div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card h-100 <%= earnedBadges.includes('Active Learner') ? 'border-success' : 'opacity-50' %>">
                    <div class="card-body text-center">
                        <img src="/images/active_learner.jpg" alt="Active Learner" style="height: 64px;">
                        <h5 class="card-title mt-2">Active Learner</h5>
                        <p class="card-text">Complete 5 skill exchanges</p>
                        <% if (earnedBadges.includes('Active Learner')) { %>
                            <span class="badge bg-success fs-6">Earned</span>
                        <% } else { %>
                            <span class="badge bg-secondary fs-6">Locked</span>
                            <div class="mt-2">
                                <small>Progress: <%= Math.min(totalExchanges, 5) %> / 5</small>
                                <div class="progress mt-1" style="height: 8px;">
                                    <div class="progress-bar" data-width="<%= ((totalExchanges / 5) * 100) + '%' %>"></div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card h-100 <%= earnedBadges.includes('Top Teacher') ? 'border-success' : 'opacity-50' %>">
                    <div class="card-body text-center">
                        <img src="/images/top_teacher.jpg" alt="Top Teacher" style="height: 64px;">
                        <h5 class="card-title mt-2">Top Teacher</h5>
                        <p class="card-text">Teach 5 skills to other users</p>
                        <% if (earnedBadges.includes('Top Teacher')) { %>
                            <span class="badge bg-success fs-6">Earned</span>
                        <% } else { %>
                            <span class="badge bg-secondary fs-6">Locked</span>
                            <div class="mt-2">
                                <small>Progress: <%= Math.min(teacherExchanges, 5) %> / 5</small>
                                <div class="progress mt-1" style="height: 8px;">
                                    <div class="progress-bar" data-width="<%= ((teacherExchanges / 5) * 100) + '%' %>"></div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card h-100 <%= earnedBadges.includes('Skill Master') ? 'border-success' : 'opacity-50' %>">
                    <div class="card-body text-center">
                        <img src="/images/skill_master.jpg" alt="Skill Master" style="height: 64px;">
                        <h5 class="card-title mt-2">Skill Master</h5>
                        <p class="card-text">Complete 10 skill exchanges</p>
                        <% if (earnedBadges.includes('Skill Master')) { %>
                            <span class="badge bg-success fs-6">Earned</span>
                        <% } else { %>
                            <span class="badge bg-secondary fs-6">Locked</span>
                            <div class="mt-2">
                                <small>Progress: <%= Math.min(totalExchanges, 10) %> / 10</small>
                                <div class="progress mt-1" style="height: 8px;">
                                    <div class="progress-bar" data-width="<%= ((totalExchanges / 10) * 100) + '%' %>"></div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card h-100 <%= earnedBadges.includes('Community Hero') ? 'border-success' : 'opacity-50' %>">
                    <div class="card-body text-center">
                        <img src="/images/community_hero.jpg" alt="Community Hero" style="height: 64px;">
                        <h5 class="card-title mt-2">Community Hero</h5>
                        <p class="card-text">Complete 20 skill exchanges</p>
                        <% if (earnedBadges.includes('Community Hero')) { %>
                            <span class="badge bg-success fs-6">Earned</span>
                        <% } else { %>
                            <span class="badge bg-secondary fs-6">Locked</span>
                            <div class="mt-2">
                                <small>Progress: <%= Math.min(totalExchanges, 20) %> / 20</small>
                                <div class="progress mt-1" style="height: 8px;">
                                    <div class="progress-bar" data-width="<%= ((totalExchanges / 20) * 100) + '%' %>"></div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('[data-width]').forEach(function(el) {
            el.style.width = el.getAttribute('data-width');
        });
    </script>
</body>
</html>