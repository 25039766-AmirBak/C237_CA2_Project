<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | SkillSwap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/navbar.css">
</head>

<body class="admin-page">

    <%- include('partials/navbar') %>

    <main class="admin-wrapper">

        <section class="admin-header">

            <div>
                <p class="admin-eyebrow">
                    SkillSwap Management
                </p>

                <h1>
                    Admin Dashboard
                </h1>

                <p class="admin-subtitle">
                    View platform statistics, users and skill listings.
                </p>
            </div>

            <div class="admin-account">

                <div class="admin-avatar">
                    <%= String(currentUser.name || 'A')
                        .charAt(0)
                        .toUpperCase() %>
                </div>

                <div>
                    <strong>
                        <%= currentUser.name %>
                    </strong>

                    <span>
                        Administrator
                    </span>
                </div>

            </div>

        </section>

        <% if (
            typeof successMessages !== 'undefined' &&
            successMessages.length > 0
        ) { %>

            <% successMessages.forEach((message) => { %>
                <div class="alert alert-success">
                    <%= message %>
                </div>
            <% }) %>

        <% } %>

        <% if (
            typeof errorMessages !== 'undefined' &&
            errorMessages.length > 0
        ) { %>

            <% errorMessages.forEach((message) => { %>
                <div class="alert alert-danger">
                    <%= message %>
                </div>
            <% }) %>

        <% } %>

        <section class="statistics-grid">

            <article class="statistics-card">

                <div class="statistics-icon users-icon">
                    <i class="fa-solid fa-users"></i>
                </div>

                <div>
                    <span>
                        Total Users
                    </span>

                    <strong>
                        <%= statistics.totalUsers %>
                    </strong>
                </div>

            </article>

            <article class="statistics-card">

                <div class="statistics-icon skills-icon">
                    <i class="fa-solid fa-lightbulb"></i>
                </div>

                <div>
                    <span>
                        Total Skills
                    </span>

                    <strong>
                        <%= statistics.totalSkills %>
                    </strong>
                </div>

            </article>

            <article class="statistics-card">

                <div class="statistics-icon matches-icon">
                    <i class="fa-solid fa-handshake"></i>
                </div>

                <div>
                    <span>
                        Total Matches
                    </span>

                    <strong>
                        <%= statistics.totalMatches %>
                    </strong>
                </div>

            </article>

            <article class="statistics-card">

                <div class="statistics-icon sessions-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <div>
                    <span>
                        Total Sessions
                    </span>

                    <strong>
                        <%= statistics.totalSessions %>
                    </strong>
                </div>

            </article>

        </section>

        <section class="admin-panel">

            <div class="panel-heading">

                <div>
                    <p class="panel-label">
                        User Management
                    </p>

                    <h2>
                        Registered Users
                    </h2>
                </div>

                <span class="record-count">
                    <%= users.length %> records
                </span>

            </div>

            <div class="table-responsive">

                <table class="table admin-table align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>User</th>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Points</th>
                            <th>Level</th>
                            <th>Joined</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (users.length === 0) { %>

                            <tr>
                                <td
                                    colspan="7"
                                    class="text-center text-muted py-5"
                                >
                                    No users found.
                                </td>
                            </tr>

                        <% } %>

                        <% users.forEach((user) => { %>

                            <tr>

                                <td>
                                    #<%= user.id %>
                                </td>

                                <td>

                                    <div class="table-user">

                                        <div class="small-avatar">
                                            <%= String(user.name || 'U')
                                                .charAt(0)
                                                .toUpperCase() %>
                                        </div>

                                        <div>
                                            <strong>
                                                <%= user.name %>
                                            </strong>

                                            <span>
                                                <%= user.email %>
                                            </span>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <%= user.contact || 'Not provided' %>
                                </td>

                                <td>

                                    <span
                                        class="role-badge
                                        <%= String(user.role).toLowerCase() === 'admin'
                                            ? 'admin-role'
                                            : 'user-role' %>"
                                    >
                                        <%= user.role || 'user' %>
                                    </span>

                                </td>

                                <td>
                                    <%= user.points || 0 %>
                                </td>

                                <td>
                                    <%= user.level || 1 %>
                                </td>

                                <td>
                                    <%= user.created_at
                                        ? new Date(user.created_at)
                                            .toLocaleDateString('en-SG')
                                        : 'Not available' %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </section>

        <section class="admin-panel">

            <div class="panel-heading">

                <div>
                    <p class="panel-label">
                        Content Management
                    </p>

                    <h2>
                        Recent Skill Listings
                    </h2>
                </div>

                <span class="record-count">
                    <%= skills.length %> records
                </span>

            </div>

            <div class="table-responsive">

                <table class="table admin-table align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Skill</th>
                            <th>Owner</th>
                            <th>Category</th>
                            <th>Level</th>
                            <th>Type</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (skills.length === 0) { %>

                            <tr>
                                <td
                                    colspan="8"
                                    class="text-center text-muted py-5"
                                >
                                    No skills found.
                                </td>
                            </tr>

                        <% } %>

                        <% skills.forEach((skill) => { %>

                            <tr>

                                <td>
                                    #<%= skill.id %>
                                </td>

                                <td>

                                    <div class="skill-table-name">

                                        <strong>
                                            <%= skill.skill_name %>
                                        </strong>

                                        <span>
                                            <%= skill.description
                                                ? skill.description.substring(0, 70)
                                                : 'No description' %>

                                            <%= skill.description &&
                                                skill.description.length > 70
                                                ? '...'
                                                : '' %>
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    <%= skill.owner_name %>
                                </td>

                                <td>
                                    <%= skill.category %>
                                </td>

                                <td>
                                    <%= skill.skill_level %>
                                </td>

                                <td>

                                    <span
                                        class="skill-type-badge
                                        <%= String(skill.skill_type).toLowerCase() === 'offer'
                                            ? 'offer-type'
                                            : 'learn-type' %>"
                                    >
                                        <%= skill.skill_type %>
                                    </span>

                                </td>

                                <td>
                                    <%= skill.created_at
                                        ? new Date(skill.created_at)
                                            .toLocaleDateString('en-SG')
                                        : 'Not available' %>
                                </td>

                                <td>

                                    <form
                                        action="/admin/skills/<%= skill.id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Delete this skill listing?');"
                                    >

                                        <button
                                            type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                        >
                                            <i class="fa-solid fa-trash"></i>
                                            Delete
                                        </button>

                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</body>
</html>