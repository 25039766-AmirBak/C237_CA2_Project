<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/skill.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <title>Edit Skill | SkillSwap</title>
</head>

<body class="edit-skill-page">

    <%- include('partials/navbar') %>

    <div class="edit-skill-container">

        <div class="edit-skill-header">
            <p class="edit-skill-label">Manage Your Listing</p>
            <h1 class="page-title">Edit Skill</h1>
            <p class="page-subtitle">Update your skill information and keep your listing accurate.</p>
        </div>

        <% if (typeof error !== "undefined" && error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form
            action="/skills/<%= skill.id %>/edit" method="POST" class="edit-skill-form"
        >

            <!-- Skill Name -->
            <div class="form-group">
                <label>Skill Name</label>

                <input type="text" id="skill_name" name="skill_name"  placeholder="Example: Python Programming" value=" <%= skill.skill_name || '' %>"  required >
            </div>

            <!-- Category -->
            <div class="form-group">
                <label>Category</label>

                <select id="category" name="category" required >

                    <option value=""> Choose a Category</option>

                    <option
                        value="Technology" <%= skill.category === "Technology" ? "selected" : "" %>>
                        Technology
                    </option>

                    <option
                        value="Design" <%= skill.category === "Design" ? "selected" : "" %>>
                        Design
                    </option>

                    <option
                        value="Music"  <%= skill.category === "Music" ? "selected" : "" %>>
                        Music
                    </option>

                    <option
                        value="Language" <%= skill.category === "Language" ? "selected" : "" %>>
                        Language
                    </option>

                    <option
                        value="Lifestyle" <%= skill.category === "Lifestyle" ? "selected" : "" %>>
                        Lifestyle
                    </option>

                    <option
                        value="Business" <%= skill.category === "Business" ? "selected" : "" %>>
                        Business
                    </option>

                    <option
                        value="Sports" <%= skill.category === "Sports" ? "selected" : "" %>>
                        Sports
                    </option>

                    <option
                        value="Other" <%= skill.category === "Other" ? "selected" : "" %>>
                        Other
                    </option>
                </select>

            </div>

            <!-- Skill Level -->
            <div class="form-group">

                <label> Skill Level</label>
                <select id="skill_level"  name="skill_level" required >

                    <option value="">Select Level </option>

                    <option
                        value="Beginner"
                        <%= skill.skill_level === "Beginner" ? "selected" : "" %>
                    >
                        Beginner
                    </option>

                    <option
                        value="Intermediate"
                        <%= skill.skill_level === "Intermediate" ? "selected" : "" %>
                    >
                        Intermediate
                    </option>

                    <option
                        value="Advanced"
                        <%= skill.skill_level === "Advanced" ? "selected" : "" %>
                    >
                        Advanced
                    </option>

                    <option
                        value="Expert"
                        <%= skill.skill_level === "Expert" ? "selected" : "" %>
                    >
                        Expert
                    </option>

                </select>

            </div>

            <!-- Skill Type -->
            <div class="form-group">

                <label>Skill Type </label>
                <select id="skill_type" name="skill_type" required >

                    <option value=""> Select Skill Type </option>

                    <option
                        value="Offer"
                        <%= skill.skill_type === "Offer" ? "selected" : "" %>
                    >
                        Offering This Skill
                    </option>

                    <option
                        value="Learn"
                        <%= skill.skill_type === "Learn" ? "selected" : "" %>
                    >
                        Looking to Learn This Skill
                    </option>

                </select>

            </div>

            <!-- Description -->
            <div class="form-group">
                <label>Description</label>
                <textarea id="description" name="description" rows="6" placeholder="Tell others what you will learn or teach..."required><%= skill.description || "" %></textarea>
            </div>

            <!-- Availability -->
            <div class="form-group">

                <label >Availability </label>

                <select id="availability" name="availability" required>

                    <option value="">Select Availability</option>

                    <option
                        value="Weekdays"
                        <%= skill.availability === "Weekdays" ? "selected" : "" %>
                    >
                        Weekdays
                    </option>

                    <option
                        value="Weekends"
                        <%= skill.availability === "Weekends" ? "selected" : "" %>
                    >
                        Weekends
                    </option>

                    <option
                        value="Evenings"
                        <%= skill.availability === "Evenings" ? "selected" : "" %>
                    >
                        Evenings
                    </option>

                    <option value="Flexible" <%= skill.availability === "Flexible" ? "selected" : "" %> > Flexible </option>

                </select>
            </div>

            <!-- Location -->
            <div class="form-group">
                <label>Location </label>
                <input type="text" id="location" name="location"  placeholder="Example: Online / Tampines"value="<%= skill.location || '' %>" required>
            </div>

            <!-- Buttons -->
            <div class="edit-button-group">
                <a href="/my-skills" class="edit-cancel-btn" > Cancel</a>

                <button
                    type="submit" class="edit-save-btn">Save Changes
                </button>

            </div>
        </form>
    </div>

</body>
</html>

