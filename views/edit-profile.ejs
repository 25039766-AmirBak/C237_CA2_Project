<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Profile | SkillSwap</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/navbar.css">
</head>

<body class="profile-page">

    <%- include('partials/navbar') %>

    <main class="profile-wrapper">

        <section class="edit-profile-card">

            <div class="auth-heading">
                <div class="auth-icon">
                    <i class="fa-solid fa-user-pen"></i>
                </div>

                <h1>Edit Profile</h1>

                <p>Update your details so other members know who you are.</p>
            </div>

            <% if (success) { %>
                <div class="alert alert-success" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i><%= success %>
                </div>
            <% } %>

            <% if (error) { %>
                <div class="alert alert-danger" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
                </div>
            <% } %>

            <form action="/profile/edit" method="POST" enctype="multipart/form-data">
                <div class="row g-3">

                    <div class="col-12 d-flex align-items-center gap-3">
                        <div class="profile-avatar" style="width: 84px; height: 84px; font-size: 2rem; border-width: 4px;">
                            <% if (profilePicture) { %>
                                <img
                                    src="/images/<%= profilePicture %>"
                                    alt="Current profile picture"
                                >
                            <% } else { %>
                                <%= String(profileUser.name || 'U').charAt(0).toUpperCase() %>
                            <% } %>
                        </div>

                        <div>
                            <strong><%= profileUser.name %></strong>
                            <p class="text-muted m-0"><%= profileUser.email %></p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="name" class="form-label">Full Name *</label>
                        <input type="text" id="name" name="name" class="form-control" maxlength="100" value="<%= profileUser.name %>" required>
                    </div>

                    <div class="col-md-6">
                        <label for="contact" class="form-label">Contact Number *</label>
                        <input type="text" id="contact" name="contact" class="form-control" maxlength="30" value="<%= profileUser.contact || '' %>" required>
                    </div>

                    <div class="col-12">
                        <label for="profile_picture" class="form-label">Change Profile Picture</label>
                        <input type="file" id="profile_picture" name="profile_picture" class="form-control" accept="image/*">
                        <small class="text-muted"> Optional, max 2MB. Leave empty to keep your current picture.</small>
                    </div>

                    <div class="col-12">
                        <label for="bio" class="form-label"> Bio </label>
                        <textarea id="bio" name="bio" class="form-control" maxlength="500" placeholder="Tell others a little about yourself..."><%= profileUser.bio || '' %></textarea>
                    </div>

                    <div class="col-12 mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary auth-button flex-grow-1">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
                        </button>

                        <a href="/profile" class="btn btn-outline-secondary auth-button d-flex align-items-center">
                            Cancel
                        </a>
                    </div>

                </div>
            </form>

        </section>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
