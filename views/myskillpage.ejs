<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/skill.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <title>My Skills | SkillSwap</title>
</head>

<body class="myskill-page">
    <%- include('partials/navbar') %>
            
    <div class="myskill-container">

        <% if (success) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>

        <div class="myskill-header">
            <div>
                <h1>My Skills</h1>
                <p>Manage the skills you teach and share.</p>
            </div>

            <a href="/skills/add" class=" myskill-add-btn"> + Add New Skill</a>
        </div>

        <% if(skills.length > 0){ %>

            <% skills.forEach(skill => { %>

            <div class="myskill-card">

                <div class="myskill-icon">
                    <% if (skill.category === "Technology") { %> &lt;/&gt;
                    <% } else if (skill.category === "Design") { %> ✎
                    <% } else if (skill.category === "Music") { %>  ♫
                    <% } else if (skill.category === "Language") { %> 文
                    <% } else if (skill.category === "Lifestyle") { %> ✦
                    <% } else if (skill.category === "Business") { %> ◫
                    <% } else if (skill.category === "Sports") { %>⚡
                    <% } else { %> ✧<% } %>
                </div>

                <div class="myskill-information">
                    <h3><%= skill.skill_name %></h3>

                    <div class="myskill-tags">
                        <span class="myskill-category"><%= skill.category %></span>
                        <span class="myskill-level"><%= skill.skill_level %></span>
                    </div>

                    <p class="myskill-description"> <%= skill.description %> </p>
                </div>
                
                <details class="myskill-menu">
                    <summary>•••</summary>

                        <div class="myskill-menu-options">
                            <a href="/skills/<%= skill.id %>/edit" class="myskill-edit-btn"> Edit Skill</a>

                            <form action="/skills/<%= skill.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this skill?');">
                                <button type="submit" class="myskill-delete-btn"> Delete Skill</button>
                            </form>

                    </div>
                </details>
            </div>
        <% }) %>
    </div>
 <% } else { %>

            <div class="empty-state">
                <h2>No skills yet.</h2>
                <p>Start sharing your first skill today.</p>
                <a href="/skills/add" class=" myskill-add-btn">Add Skill</a>

            </div>
        <% } %>
    </div>
</body>
</html>