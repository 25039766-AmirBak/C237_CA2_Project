<!-- ==========================================================
    SCHEDULE

    Team Member:
    - Member 5 (Scheduling)

    Notes:
    - Session Cards show my upcoming confirmed sessions
    - Booking form below prevents overlapping sessions (checked server-side)
    - All times assumed to be Singapore time (single-timezone app)
========================================================== -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>SkillSwap - Schedule</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container py-4">

        <% errors.forEach(function(e) { %>
            <div class="alert alert-danger"><%= e %></div>
        <% }) %>
        <% successMsgs.forEach(function(s) { %>
            <div class="alert alert-success"><%= s %></div>
        <% }) %>

        <h3 class="mb-4">My Learning Sessions</h3>

        <!-- Session Cards -->
        <div class="row mb-5">
            <% if (sessions.length === 0) { %>
                <p class="text-muted">No upcoming sessions booked.</p>
            <% } %>
            <% sessions.forEach(function(s) { %>
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title"><%= s.skill_topic || 'Learning Session' %></h5>
                            <p class="card-text mb-1">
                                With:
                                <strong>
                                    <%= (s.requester_id == user.id) ? s.partner_username : s.requester_username %>
                                </strong>
                            </p>
                            <p class="card-text mb-1">
                                <%= (s.session_date instanceof Date) ? s.session_date.toISOString().slice(0,10) : s.session_date %>
                            </p>
                            <p class="card-text mb-2"><%= s.start_time %> - <%= s.end_time %></p>
                            <form method="POST" action="/schedule/cancel/<%= s.id %>" onsubmit="return confirm('Cancel this session?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <!-- Booking Form -->
        <h4 class="mb-3">Book a New Session</h4>
        <form method="POST" action="/schedule" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Partner</label>
                <select name="partner_id" class="form-select" required>
                    <option value="">Select a user...</option>
                    <% allUsers.forEach(function(u) { %>
                        <option value="<%= u.id %>"><%= u.username %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Skill / Topic</label>
                <input type="text" name="skill_topic" class="form-control" placeholder="e.g. Guitar basics">
            </div>
            <div class="col-md-2">
                <label class="form-label">Date</label>
                <input type="date" name="session_date" class="form-control" required>
            </div>
            <div class="col-md-1">
                <label class="form-label">Start</label>
                <input type="time" name="start_time" class="form-control" required>
            </div>
            <div class="col-md-1">
                <label class="form-label">End</label>
                <input type="time" name="end_time" class="form-control" required>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Book Session</button>
            </div>
        </form>
    </div>
</body>
</html>
